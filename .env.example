# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The public HTTPS URL where this bot server is hosted (e.g., Cloud Run or production domain).
# Required for Telegram Webhook auto-registration.
APP_URL=""

# TELEGRAM_BOT_TOKEN: The Telegram Bot API token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_MODE: "webhook" for production HTTPS webhooks, "polling" for local development getUpdates.
TELEGRAM_MODE="webhook"

# TELEGRAM_WEBHOOK_SECRET: Optional secret token verified in X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_ALLOWED_USERS: Comma-separated list of numeric Telegram User/Chat IDs or @usernames for Private Mode.
# If left empty, the bot operates in public mode.
TELEGRAM_ALLOWED_USERS=""

# NODE_ENV: Set to "production" in deployed container environments.
NODE_ENV="production"
